{
  "name": "@dank-inc/sketchy-3d",
  "version": "1.0.0",
  "author": "Elijah Lucian",
  "description": "A lightweight wrapper around three.js for creative coders",
  "repository": {
    "type": "git",
    "url": "https://github.com/dank-inc/sketchy-3d"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "typescript",
    "webgl",
    "threejs",
    "creative coding",
    "creative",
    "genart",
    "generative",
    "datavis",
    "vis"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "lint:demo": "tsc -p demo",
    "clean": "rm -rf lib",
    "compile": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run clean && npm run compile",
    "deploy": "npm publish --access public",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "devDependencies": {
    "@dank-inc/banger": "^0.14.1",
    "@dank-inc/lewps": "^1.0.0",
    "@dank-inc/numbaz": "^0.6.1",
    "@dank-inc/super-mouse": "^0.10.2",
    "@types/node": "^22.10.5",
    "three": "^0.172.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dank-inc/sketchy": "^2.0.0",
    "@types/three": "^0.171.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
